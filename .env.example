# Browser-safe local API location. This is a URL, not a secret.
VITE_OLYSTATE_API_URL=http://127.0.0.1:8788

# Local Node API settings.
OLYSTATE_API_PORT=8788
OLYSTATE_DB_PATH=./data/olystate.sqlite

# Server-only ecosystem credentials. Never prefix these with VITE_.
ATHLETEOS_HUB_URL=http://127.0.0.1:3000
ATHLETEOS_SERVICE_KEY=

# Optional: allow Control Center writes from one deployed web origin.
# Loopback origins are allowed automatically.
OLYSTATE_ALLOWED_ORIGIN=

# Optional server-only observability connection.
SENTIOS_URL=http://127.0.0.1:4777
SENTIOS_API_KEY=
